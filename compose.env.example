# Switching mounts does not migrate data.

# Copy to .env for Docker Compose (separate from the server's dev.env).
# Default: a Docker-managed named volume.
CAIRN_DB_STORAGE_TYPE=volume
CAIRN_DB_STORAGE_SOURCE=postgres_data

# To use a host directory, replace BOTH values:
# CAIRN_DB_STORAGE_TYPE=bind
# CAIRN_DB_STORAGE_SOURCE=/absolute/path/to/cairn/postgres
