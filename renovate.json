{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "constraints.npm: lock files are written with npm 11, like CI (build-base) and web/.nvmrc. npm 12 (allow-remote=none) cannot update a lock file that holds a bundleDependencies package such as @tailwindcss/oxide-wasm32-wasi (npm/cli#9800); drop the constraint once that is fixed.",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    "customManagers:makefileVersions",
    "customManagers:githubActionsVersions"
  ],
  "automerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "constraints": { "npm": "^12.0.0" },
  "platformAutomerge": false,
  "lockFileMaintenance": { "enabled": true },
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "pre-commit": { "enabled": true },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "labels": ["security"] },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules (non-major)"
    },
    {
      "description": "Go major versions change the module path and need a code migration; never automerge them.",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["needs-migration"]
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "web npm (non-major)"
    },
    {
      "description": "SvelteKit majors and its adapters only work together.",
      "matchPackageNames": ["@sveltejs/kit", "@sveltejs/adapter-*"],
      "matchUpdateTypes": ["major"],
      "groupName": "sveltekit (major)"
    },
    {
      "description": "The build-base image floats on its major tag by design; downstream repos pull :1.",
      "matchDepNames": ["ghcr.io/opencairn-org/cairn-build-base"],
      "pinDigests": false
    }
  ]
}
